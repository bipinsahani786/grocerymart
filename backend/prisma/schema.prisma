datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserStatus {
  active
  banned
  suspended
}

enum ProductType {
  simple
  weighted
  variable
  bundle
  service
  perishable
}

enum Role {
  SUPER_ADMIN
  STORE_MANAGER
  CASHIER
  PICKER
  DELIVERY_PARTNER
  CUSTOMER
}

enum OrderType {
  POS // Walk-in, counter
  DELIVERY // Online, deliver to home
  CLICK_COLLECT // Online order, store pickup
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PACKING
  PACKED
  READY_FOR_PICKUP // C&C only
  OUT_FOR_DELIVERY // Delivery only
  DELIVERED
  COLLECTED // C&C — customer picked up
  COMPLETED // POS — bill paid
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  SPLIT
  CREDIT // Khata/Udhar
  ONLINE // Razorpay
  LOYALTY_PTS
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── USERS ──────────────────────────────────────────────────────────────────
model User {
  id             String         @id @default(uuid())
  phone          String         @unique
  email          String?        @unique
  passwordHash   String?        @map("password_hash")
  name           String?
  avatar         String?
  status         UserStatus     @default(active)
  pin            String?        // 4-6 digit PIN for POS login
  isActive       Boolean        @default(true)
  loyaltyPoints  Int            @default(0) @map("loyalty_points")
  walletBalance  Float          @default(0) @map("wallet_balance")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Foreign keys
  storeId        String?        @map("store_id")

  // Relations
  store          Store?         @relation("StoreUsers", fields: [storeId], references: [id])
  managedStore   Store?         @relation("StoreManager")
  role           UserRole?
  orders         Order[]        @relation("CustomerOrders")
  staffOrders    Order[]        @relation("StaffOrders")
  shifts         StaffShift[]

  addresses      Address[]
  deliveryProfile DeliveryPartner?
  staffStore     StoreStaff[]
  creditLedger   CreditLedger[]
  auditLogs      AuditLog[]
  deliveryAssignments DeliveryAssignment[] @relation("DeliveryPartnerAssignments")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  roleName  String   @map("role_name") // E.g., 'super_admin', 'store_manager'
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  city      String
  state     String
  zipCode   String   @map("zip_code")
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]

  @@map("addresses")
}

// ─── STORES ─────────────────────────────────────────────────────────────────
model Store {
  id                  String   @id @default(uuid())
  name                String
  address             String
  lat                 Float
  long                Float
  radiusKm            Float    @default(3) @map("radius_km")
  phone               String?
  gstin               String?
  openingTime         String   @default("08:00") @map("opening_time")
  closingTime         String   @default("22:00") @map("closing_time")
  isActive            Boolean  @default(true) @map("is_active")
  posEnabled          Boolean  @default(true) @map("pos_enabled")
  deliveryEnabled     Boolean  @default(true) @map("delivery_enabled")
  clickCollectEnabled Boolean  @default(true) @map("click_collect_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Manager Relation (1-to-1)
  managerId           String?  @unique @map("manager_id")
  manager             User?    @relation("StoreManager", fields: [managerId], references: [id])

  // Users belonging to this store (1-to-many)
  users               User[]   @relation("StoreUsers")
  categories          Category[]
  products            Product[]
  inventory           StoreInventory[]
  orders              Order[]
  bills               Bill[]
  shifts              StaffShift[]

  racks               Rack[]
  staff               StoreStaff[]
  deliveryPartners    DeliveryPartnerStore[]
  pickupSlots         PickupSlot[]

  @@map("stores")
}

// ─── CATALOG ────────────────────────────────────────────────────────────────
model Category {
  id        String    @id @default(uuid())
  storeId   String    @map("store_id")
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?   @map("parent_id")
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id                    String           @id @default(uuid())
  storeId               String           @map("store_id")
  store                 Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                  String
  sku                   String?          @unique
  barcode               String?          @unique
  brand                 String?
  description           String?
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  productType           String           @default("simple") // simple, variant, bundle, weighted
  unit                  String           @default("pcs") // pcs, kg, gm, ltr, ml, pack
  basePrice             Float            @default(0)
  mrp                   Float?
  costPrice             Float?           // private — for margin calc
  taxCategory           String           @default("EXEMPT") // EXEMPT, GST5, GST12, GST18
  hsnCode               String?
  imageUrls             String[]         @default([])
  showOnApp             Boolean          @default(true)
  showOnPOS             Boolean          @default(true)
  availableForDelivery  Boolean          @default(true)
  availableForClickCollect Boolean       @default(true)
  salesCount            Int              @default(0) // for popularity sort
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  variants              ProductVariant[]
  inventory             StoreInventory[]
  orderItems            OrderItem[]
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String   // "500ml", "Red-L"
  barcode     String?  @unique
  price       Float
  mrp         Float?
  costPrice   Float?
  imageUrl    String?
  inventory   StoreInventory[]
  orderItems  OrderItem[]
  @@map("product_variants")
}

// ─── INVENTORY ──────────────────────────────────────────────────────────────
model StoreInventory {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  rackId        String?
  rack          Rack?    @relation(fields: [rackId], references: [id])
  quantity      Int      @default(0)
  priceOverride Float?
  lowStockAt    Int      @default(10)
  expiryDate    DateTime?
  lastUpdated   DateTime @updatedAt
  stockLogs     StockLog[]

  @@unique([storeId, productId, variantId])
  @@map("store_inventory")
}

model StockLog {
  id          String   @id @default(uuid())
  inventoryId String
  inventory   StoreInventory @relation(fields: [inventoryId], references: [id])
  delta       Int      // positive = stock in, negative = out
  reason      String   // sale, return, damage, expiry, adjustment, transfer
  referenceId String?  // orderId or transferId
  staffId     String?
  createdAt   DateTime @default(now())
  @@map("stock_logs")
}

model Rack {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  inventory StoreInventory[]

  @@map("racks")
}

// ─── STAFF ──────────────────────────────────────────────────────────────────
model StoreStaff {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  storeId     String   @map("store_id")
  store       Store    @relation(fields: [storeId], references: [id])
  role        Role
  maxDiscount Float    @default(0.1) @map("max_discount") // max 10% by default
  isActive    Boolean  @default(true) @map("is_active")
  joinedAt    DateTime @default(now()) @map("joined_at")
  shifts      Shift[]

  @@unique([userId, storeId])
  @@map("store_staff")
}

model Shift {
  id          String    @id @default(uuid())
  staffId     String    @map("staff_id")
  staff       StoreStaff @relation(fields: [staffId], references: [id])
  clockIn     DateTime  @map("clock_in")
  clockOut    DateTime? @map("clock_out")
  ordersCount Int       @default(0) @map("orders_count")
  revenue     Float     @default(0)

  @@map("shifts")
}

model DeliveryPartner {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycStatus   KYCStatus @default(PENDING) @map("kyc_status")
  vehicleType String?  @map("vehicle_type")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  stores      DeliveryPartnerStore[]

  @@map("delivery_partners")
}

model DeliveryPartnerStore {
  id                String          @id @default(uuid())
  deliveryPartnerId String          @map("delivery_partner_id")
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  storeId           String          @map("store_id")
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([deliveryPartnerId, storeId])
  @@map("delivery_partner_stores")
}

// ─── ORDERS & TRANSACTIONS ──────────────────────────────────────────────────
model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // POS-2024-00001, DEL-2024-00001
  type            OrderType
  status          OrderStatus   @default(PLACED)
  
  customerId      String?       // null for anonymous POS
  customer        User?         @relation("CustomerOrders", fields: [customerId], references: [id])
  
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  
  staffId         String?       // who created (for POS)
  staff           User?         @relation("StaffOrders", fields: [staffId], references: [id])
  
  addressId       String?       // null for POS/C&C
  address         Address?      @relation(fields: [addressId], references: [id])
  
  pickupSlotId    String?       // C&C only
  pickupSlot      PickupSlot?   @relation(fields: [pickupSlotId], references: [id])
  
  pickupPin       String?       // 4-digit PIN for C&C
  pickupQr        String?       // QR code string for C&C
  
  subtotal        Float
  discount        Float         @default(0)
  discountReason  String?
  taxAmount       Float         @default(0)
  deliveryFee     Float         @default(0)
  totalAmount     Float
  notes           String?
  customerNote    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  payment         Payment?
  bill            Bill?
  deliveryAssignment DeliveryAssignment?
  statusHistory   OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  
  name          String   // snapshot at time of order
  qty           Float
  unit          String
  priceAtOrder  Float
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  itemDiscount  Float    @default(0)
  note          String?
  isPacked      Boolean  @default(false) // picker checklist
  
  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  status      OrderStatus
  note        String?
  staffId     String?
  createdAt   DateTime @default(now())
  @@map("order_status_history")
}

model DeliveryAssignment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  partnerId   String
  partner     User     @relation("DeliveryPartnerAssignments", fields: [partnerId], references: [id])
  status      String   @default("ASSIGNED")
  createdAt   DateTime @default(now())
  @@map("delivery_assignments")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  cashReceived  Float?        @map("cash_received")
  changeGiven   Float?        @map("change_given")
  txnId         String?       @map("txn_id")
  splitDetails  Json?         @map("split_details")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Bill {
  id          String   @id @default(uuid())
  billNumber  String   @unique @map("bill_number")
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId     String   @map("store_id")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type        String   @default("RECEIPT")
  pdfUrl      String?  @map("pdf_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bills")
}

model StaffShift {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffId     String    @map("staff_id")
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftName   String    @default("General") @map("shift_name")
  clockIn     DateTime? @map("clock_in")
  clockOut    DateTime? @map("clock_out")
  ordersHandled Int     @default(0) @map("orders_handled")
  revenue     Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("staff_shifts")
}

model CreditLedger {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // CREDIT or DEBIT/PAYMENT
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("credit_ledgers")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PickupSlot {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  maxOrders Int      @default(10) @map("max_orders")
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]

  @@map("pickup_slots")
}
