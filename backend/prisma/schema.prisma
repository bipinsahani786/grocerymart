datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserStatus {
  active
  banned
  suspended
}

enum ProductType {
  simple
  weighted
  variable
  bundle
  service
  perishable
}

enum Role {
  SUPER_ADMIN
  STORE_MANAGER
  CASHIER
  PICKER
  DELIVERY_PARTNER
  CUSTOMER
}

enum OrderType {
  POS // Walk-in, counter
  DELIVERY // Online, deliver to home
  CLICK_COLLECT // Online order, store pickup
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PACKING
  PACKED
  READY_FOR_PICKUP // C&C only
  OUT_FOR_DELIVERY // Delivery only
  DELIVERED
  COLLECTED // C&C — customer picked up
  COMPLETED // POS — bill paid
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  SPLIT
  CREDIT // Khata/Udhar
  ONLINE // Razorpay
  LOYALTY_PTS
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── USERS ──────────────────────────────────────────────────────────────────
model User {
  id             String         @id @default(uuid())
  phone          String         @unique
  email          String?        @unique
  passwordHash   String?        @map("password_hash")
  name           String?
  avatar         String?
  dob            String?
  referralCode   String?        @map("referral_code")
  status         UserStatus     @default(active)
  pin            String?        // 4-6 digit PIN for POS login
  isActive       Boolean        @default(true)
  loyaltyPoints  Int            @default(0) @map("loyalty_points")
  walletBalance  Float          @default(0) @map("wallet_balance")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Foreign keys
  storeId        String?        @map("store_id")

  // Relations
  store          Store?         @relation("StoreUsers", fields: [storeId], references: [id])
  managedStore   Store?         @relation("StoreManager")
  role           UserRole?
  orders         Order[]        @relation("CustomerOrders")
  staffOrders    Order[]        @relation("StaffOrders")
  shifts         StaffShift[]

  addresses      Address[]
  deliveryProfile DeliveryPartner?
  staffStore     StoreStaff[]
  creditLedger   CreditLedger[]
  auditLogs      AuditLog[]
  deliveryAssignments DeliveryAssignment[] @relation("DeliveryPartnerAssignments")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  roleName  String   @map("role_name") // E.g., 'super_admin', 'store_manager'
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  city      String
  state     String
  zipCode   String   @map("zip_code")
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]

  @@map("addresses")
}

// ─── STORES ─────────────────────────────────────────────────────────────────
model Store {
  id                  String   @id @default(uuid())
  name                String
  address             String
  lat                 Float
  long                Float
  radiusKm            Float    @default(3) @map("radius_km")
  phone               String?
  gstin               String?
  openingTime         String   @default("08:00") @map("opening_time")
  closingTime         String   @default("22:00") @map("closing_time")
  isActive            Boolean  @default(true) @map("is_active")
  posEnabled          Boolean  @default(true) @map("pos_enabled")
  deliveryEnabled     Boolean  @default(true) @map("delivery_enabled")
  clickCollectEnabled Boolean  @default(true) @map("click_collect_enabled")
  deliveryChargePerKm Float    @default(0.0) @map("delivery_charge_per_km")
  freeDeliveryKmRadius Float   @default(0.0) @map("free_delivery_km_radius")
  minDeliveryCharge   Float    @default(0.0) @map("min_delivery_charge")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Manager Relation (1-to-1)
  managerId           String?  @unique @map("manager_id")
  manager             User?    @relation("StoreManager", fields: [managerId], references: [id])

  // Users belonging to this store (1-to-many)
  users               User[]   @relation("StoreUsers")
  categories          Category[]
  products            Product[]
  inventory           StoreInventory[]
  orders              Order[]
  bills               Bill[]
  shifts              StaffShift[]

  racks               Rack[]
  staff               StoreStaff[]
  customers           StoreCustomer[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  batches             StoreBatch[]
  deliveryPartners    DeliveryPartnerStore[]
  pickupSlots         PickupSlot[]
  offers              StoreOffer[]
  subscriptionPlans   StoreSubscriptionPlan[]

  @@map("stores")
}

// ─── CATALOG ────────────────────────────────────────────────────────────────

model MasterCategory {
  id        String           @id @default(uuid())
  name      String           @unique
  parentId  String?          @map("parent_id")
  parent    MasterCategory?  @relation("MasterCatTree", fields: [parentId], references: [id])
  children  MasterCategory[] @relation("MasterCatTree")
  imageUrl  String?
  sortOrder Int              @default(0)
  products  MasterProduct[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("master_categories")
}

model MasterProduct {
  id              String                 @id @default(uuid())
  name            String
  sku             String?                @unique
  barcode         String?                @unique
  brand           String?
  description     String?
  categoryId      String                 @map("category_id")
  category        MasterCategory         @relation(fields: [categoryId], references: [id])
  productType     String                 @default("simple") @map("product_type") // simple, variant, loose
  unit            String                 @default("pcs")
  basePrice       Float                  @default(0) @map("base_price")
  mrp             Float?
  taxClassId      String?                @map("tax_class_id")
  taxClass        TaxClass?              @relation(fields: [taxClassId], references: [id])
  hsnCode         String?                @map("hsn_code")
  imageUrls       String[]               @default([]) @map("image_urls")
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  variants        MasterProductVariant[]
  
  @@map("master_products")
}

model MasterProductVariant {
  id          String         @id @default(uuid())
  productId   String         @map("product_id")
  product     MasterProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String         // "500ml", "Red-L"
  barcode     String?        @unique
  price       Float
  mrp         Float?
  imageUrl    String?        @map("image_url")

  @@map("master_product_variants")
}
model Category {
  id        String    @id @default(uuid())
  storeId   String    @map("store_id")
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?   @map("parent_id")
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@map("categories")
}

model Product {
  id                    String           @id @default(uuid())
  storeId               String           @map("store_id")
  store                 Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                  String
  sku                   String?          @unique
  barcode               String?          @unique
  brand                 String?
  description           String?
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  productType           String           @default("simple") // simple, variant, bundle, weighted
  unit                  String           @default("pcs") // pcs, kg, gm, ltr, ml, pack
  basePrice             Float            @default(0)
  mrp                   Float?
  costPrice             Float?           // private — for margin calc
  taxClassId            String?          @map("tax_class_id")
  taxClass              TaxClass?        @relation(fields: [taxClassId], references: [id])
  hsnCode               String?
  imageUrls             String[]         @default([])
  showOnApp             Boolean          @default(true)
  showOnPOS             Boolean          @default(true)
  availableForDelivery  Boolean          @default(true)
  availableForClickCollect Boolean       @default(true)
  salesCount            Int              @default(0) // for popularity sort
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  
  masterProductId       String?          @map("master_product_id")

  variants              ProductVariant[]
  inventory             StoreInventory[]
  orderItems            OrderItem[]
  batches               StoreBatch[]
  purchaseItems         PurchaseOrderItem[]
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String   // "500ml", "Red-L"
  barcode     String?  @unique
  price       Float
  mrp         Float?
  costPrice   Float?
  imageUrl    String?
  inventory   StoreInventory[]
  orderItems  OrderItem[]
  batches     StoreBatch[]
  purchaseItems PurchaseOrderItem[]
  @@map("product_variants")
}

// ─── INVENTORY ──────────────────────────────────────────────────────────────
model StoreInventory {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  rackId        String?
  rack          Rack?    @relation(fields: [rackId], references: [id])
  quantity      Int      @default(0)
  priceOverride Float?
  lowStockAt    Int      @default(10)
  expiryDate    DateTime?
  lastUpdated   DateTime @updatedAt
  stockLogs     StockLog[]
  batches       StoreBatch[]

  @@unique([storeId, productId, variantId])
  @@map("store_inventory")
}

model StockLog {
  id          String   @id @default(uuid())
  inventoryId String
  inventory   StoreInventory @relation(fields: [inventoryId], references: [id])
  delta       Int      // positive = stock in, negative = out
  reason      String   // sale, return, damage, expiry, adjustment, transfer
  referenceId String?  // orderId or transferId
  staffId     String?
  createdAt   DateTime @default(now())
  @@map("stock_logs")
}

model Rack {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  inventory StoreInventory[]

  @@map("racks")
}

// ─── STAFF ──────────────────────────────────────────────────────────────────
model StoreStaff {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  storeId     String   @map("store_id")
  store       Store    @relation(fields: [storeId], references: [id])
  name        String?
  email       String?
  phone       String?
  role        Role     @default(CASHIER)
  shift       String?  @default("General")
  maxDiscount Float    @default(0.1) @map("max_discount")
  isActive    Boolean  @default(true) @map("is_active")
  joinedAt    DateTime @default(now()) @map("joined_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")
  shifts      Shift[]

  @@map("store_staff")
}

model StoreCustomer {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  khataBalance  Float    @default(0) @map("khata_balance")
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  totalOrders   Int      @default(0) @map("total_orders")
  totalSpent    Float    @default(0) @map("total_spent")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("store_customers")
}

model Shift {
  id          String    @id @default(uuid())
  staffId     String    @map("staff_id")
  staff       StoreStaff @relation(fields: [staffId], references: [id])
  clockIn     DateTime  @map("clock_in")
  clockOut    DateTime? @map("clock_out")
  ordersCount Int       @default(0) @map("orders_count")
  revenue     Float     @default(0)

  @@map("shifts")
}

model DeliveryPartner {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycStatus   KYCStatus @default(PENDING) @map("kyc_status")
  vehicleType String?  @map("vehicle_type")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  stores      DeliveryPartnerStore[]

  @@map("delivery_partners")
}

model DeliveryPartnerStore {
  id                String          @id @default(uuid())
  deliveryPartnerId String          @map("delivery_partner_id")
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  storeId           String          @map("store_id")
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([deliveryPartnerId, storeId])
  @@map("delivery_partner_stores")
}

// ─── ORDERS & TRANSACTIONS ──────────────────────────────────────────────────
model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // POS-2024-00001, DEL-2024-00001
  type            OrderType
  status          OrderStatus   @default(PLACED)
  
  customerId      String?       // null for anonymous POS
  customer        User?         @relation("CustomerOrders", fields: [customerId], references: [id])
  
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  
  staffId         String?       // who created (for POS)
  staff           User?         @relation("StaffOrders", fields: [staffId], references: [id])
  
  addressId       String?       // null for POS/C&C
  address         Address?      @relation(fields: [addressId], references: [id])
  
  pickupSlotId    String?       // C&C only
  pickupSlot      PickupSlot?   @relation(fields: [pickupSlotId], references: [id])
  
  pickupPin       String?       // 4-digit PIN for C&C
  pickupQr        String?       // QR code string for C&C
  
  subtotal        Float
  discount        Float         @default(0)
  discountReason  String?
  taxAmount       Float         @default(0)
  deliveryFee     Float         @default(0)
  totalAmount     Float
  notes           String?
  customerNote    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  payment         Payment?
  bill            Bill?
  deliveryAssignment DeliveryAssignment?
  statusHistory   OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  
  name          String   // snapshot at time of order
  qty           Float
  unit          String
  priceAtOrder  Float
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  taxSplit      Json?    // stores { CGST: 9, SGST: 9 } at time of order
  itemDiscount  Float    @default(0)
  note          String?
  isPacked      Boolean  @default(false) // picker checklist
  
  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  status      OrderStatus
  note        String?
  staffId     String?
  createdAt   DateTime @default(now())
  @@map("order_status_history")
}

model DeliveryAssignment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  partnerId   String
  partner     User     @relation("DeliveryPartnerAssignments", fields: [partnerId], references: [id])
  status      String   @default("ASSIGNED")
  createdAt   DateTime @default(now())
  @@map("delivery_assignments")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  cashReceived  Float?        @map("cash_received")
  changeGiven   Float?        @map("change_given")
  txnId         String?       @map("txn_id")
  splitDetails  Json?         @map("split_details")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Bill {
  id          String   @id @default(uuid())
  billNumber  String   @unique @map("bill_number")
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId     String   @map("store_id")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type        String   @default("RECEIPT")
  pdfUrl      String?  @map("pdf_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("bills")
}

model StaffShift {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffId     String    @map("staff_id")
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftName   String    @default("General") @map("shift_name")
  clockIn     DateTime? @map("clock_in")
  clockOut    DateTime? @map("clock_out")
  ordersHandled Int     @default(0) @map("orders_handled")
  revenue     Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("staff_shifts")
}

model CreditLedger {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // CREDIT or DEBIT/PAYMENT
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("credit_ledgers")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PickupSlot {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  maxOrders Int      @default(10) @map("max_orders")
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]

  @@map("pickup_slots")
}

// ─── TAXATION ───────────────────────────────────────────────────────────────
model TaxClass {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., "GST 18%"
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  
  products    Product[]
  masterProducts MasterProduct[]
  rates       TaxRate[]
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("tax_classes")
}

model TaxRate {
  id            String    @id @default(uuid())
  taxClassId    String    @map("tax_class_id")
  taxClass      TaxClass  @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  
  effectiveFrom DateTime  @map("effective_from")
  isActive      Boolean   @default(true) @map("is_active")
  
  components    TaxComponent[]
  
  @@map("tax_rates")
}

model TaxComponent {
  id          String    @id @default(uuid())
  taxRateId   String    @map("tax_rate_id")
  taxRate     TaxRate   @relation(fields: [taxRateId], references: [id], onDelete: Cascade)
  
  name        String    // e.g., "CGST", "SGST", "CESS"
  rate        Float     // e.g., 9.0
  
  @@map("tax_components")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

// ─── SUPPLIERS & PURCHASES ──────────────────────────────────────────────────
model Supplier {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?  @map("contact_person")
  phone         String
  email         String?
  gstin         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @default(now()) @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id            String          @id @default(uuid())
  poNumber      String          @unique @map("po_number")
  storeId       String          @map("store_id")
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierId    String          @map("supplier_id")
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  status        PurchaseStatus  @default(DRAFT)     // ✅ FIX: Was RECEIVED — now correctly starts as DRAFT
  totalAmount   Float           @default(0) @map("total_amount")
  totalTax      Float           @default(0) @map("total_tax")
  invoiceNumber String?         @map("invoice_number")
  invoiceDate   DateTime?       @map("invoice_date")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @default(now()) @map("updated_at")

  items         PurchaseOrderItem[]
  batches       StoreBatch[]

  @@map("purchase_orders")
}


model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  variantId       String?       @map("variant_id")
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  batchNumber     String        @map("batch_number")
  quantity        Int
  costPrice       Float         @map("cost_price")
  mrp             Float?
  sellingPrice    Float         @map("selling_price")
  taxRate         Float         @default(0) @map("tax_rate") // Locked GST % at purchase time
  hsnCode         String?       @map("hsn_code")
  expiryDate      DateTime?     @map("expiry_date")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("purchase_order_items")
}

model StoreBatch {
  id              String         @id @default(uuid())
  batchNumber     String         @map("batch_number")
  storeId         String         @map("store_id")
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryId     String?        @map("inventory_id")
  inventory       StoreInventory? @relation(fields: [inventoryId], references: [id])
  productId       String         @map("product_id")
  product         Product        @relation(fields: [productId], references: [id])
  variantId       String?        @map("variant_id")
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  purchaseOrderId String?        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  costPrice       Float          @map("cost_price")
  mrp             Float?
  sellingPrice    Float          @map("selling_price")
  taxRate         Float          @default(0) @map("tax_rate") // FROZEN TAX RATE %
  hsnCode         String?        @map("hsn_code")
  initialQuantity Int            @map("initial_quantity")
  currentQuantity Int            @map("current_quantity")
  expiryDate      DateTime?      @map("expiry_date")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @default(now()) @map("updated_at")

  @@map("store_batches")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model StoreOffer {
  id               String      @id @default(uuid())
  storeId          String      @map("store_id")
  store            Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code             String      // e.g., "WELCOME200"
  description      String?     // e.g., "₹200 off on orders above ₹1000"
  discountType     String      @map("discount_type") // "FLAT", "PERCENT"
  discountValue    Float       @map("discount_value")
  minOrderValue    Float       @default(0.0) @map("min_order_value")
  maxDiscount      Float?      @map("max_discount")
  startDate        DateTime    @default(now()) @map("start_date")
  endDate          DateTime?   @map("end_date")
  isActive         Boolean     @default(true) @map("is_active")
  usageLimit       Int?        @map("usage_limit")
  usageCount       Int         @default(0) @map("usage_count")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@unique([storeId, code])
  @@map("store_offers")
}

model StoreSubscriptionPlan {
  id               String      @id @default(uuid())
  storeId          String      @map("store_id")
  store            Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String      // e.g., "VIP club", "Daily Milk Pass"
  description      String?
  price            Float
  durationDays     Int         @default(30) @map("duration_days")
  isActive         Boolean     @default(true) @map("is_active")
  features         String[]    @default([])
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("store_subscription_plans")
}
