<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Order Invoice - {{orderNumber}}</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #1e293b;
      background-color: #ffffff;
      padding: 24px;
      line-height: 1.4;
    }

    .invoice-card {
      max-w: 800px;
      margin: 0 auto;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 24px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #0f172a;
      padding-bottom: 16px;
      margin-bottom: 16px;
    }

    .store-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .store-logo {
      width: 36px;
      height: 36px;
      background-color: #16a34a;
      color: #ffffff;
      font-weight: 900;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
    }

    .store-title {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: -0.5px;
    }

    .store-sub {
      font-size: 10px;
      color: #64748b;
      margin-top: 2px;
    }

    .tax-badge {
      display: inline-block;
      padding: 4px 10px;
      background-color: #dcfce7;
      color: #15803d;
      font-weight: 800;
      font-size: 11px;
      border-radius: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .meta-grid {
      display: table;
      width: 100%;
      background-color: #f8fafc;
      border: 1px solid #f1f5f9;
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 20px;
    }

    .meta-col {
      display: table-cell;
      width: 50%;
      vertical-align: top;
    }

    .meta-row {
      margin-bottom: 4px;
      font-size: 11px;
      color: #475569;
    }

    .meta-row strong {
      color: #0f172a;
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    .items-table th {
      background-color: #f1f5f9;
      color: #334155;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      padding: 8px 10px;
      border-bottom: 2px solid #cbd5e1;
    }

    .items-table td {
      padding: 8px 10px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 11px;
    }

    .items-table tr:nth-child(even) {
      background-color: #fafafa;
    }

    .text-center {
      text-align: center;
    }

    .text-right {
      text-align: right;
    }

    .font-mono {
      font-family: monospace;
    }

    .font-bold {
      font-weight: 700;
    }

    .summary-section {
      display: table;
      width: 100%;
      margin-bottom: 20px;
    }

    .terms-box {
      display: table-cell;
      width: 55%;
      vertical-align: top;
      padding-right: 16px;
      font-size: 10px;
      color: #64748b;
    }

    .totals-box {
      display: table-cell;
      width: 45%;
      vertical-align: top;
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 12px 16px;
    }

    .total-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 11px;
      color: #475569;
    }

    .total-grand {
      border-top: 2px solid #0f172a;
      padding-top: 8px;
      margin-top: 8px;
      font-size: 14px;
      font-weight: 900;
      color: #16a34a;
    }

    .footer {
      border-top: 1px dashed #cbd5e1;
      padding-top: 12px;
      text-align: center;
      font-size: 10px;
      color: #64748b;
    }
  </style>
</head>

<body>
  <div class="invoice-card">
    <!-- Header -->
    <div class="header">
      <div class="store-brand">
        {{#if storeLogo}}
        <img src="{{storeLogo}}" alt="{{storeName}}"
          style="max-width: 48px; max-height: 48px; object-fit: contain; border-radius: 6px;" />
        {{else}}
        <div class="store-logo">{{storeInitials}}</div>
        {{/if}}
        <div>
          <div class="store-title">{{storeName}}</div>
          {{#if storeAddress}}<div class="store-sub">{{storeAddress}}</div>{{/if}}
          <div class="store-sub font-mono">
            {{#if storeGstin}}GSTIN: {{storeGstin}}{{/if}}
            {{#if storeGstin}}{{#if storeFssai}} | {{/if}}{{/if}}
            {{#if storeFssai}}FSSAI: {{storeFssai}}{{/if}}
          </div>
        </div>
      </div>
      <div class="text-right">
        <div class="tax-badge">TAX INVOICE</div>
        <div style="font-size: 9px; color: #94a3b8; margin-top: 4px;">ORIGINAL FOR RECIPIENT</div>
      </div>
    </div>

    <!-- Metadata Grid -->
    <div class="meta-grid">
      <div class="meta-col">
        <div class="meta-row">Invoice No: <strong class="font-mono">{{orderNumber}}</strong></div>
        <div class="meta-row">Invoice Date: <strong>{{invoiceDate}}</strong></div>
        <div class="meta-row">Payment Mode: <strong
            style="color: #16a34a; text-transform: uppercase;">{{paymentMethod}}</strong></div>
      </div>
      <div class="meta-col text-right">
        <div class="meta-row">Cashier (Billed By): <strong>{{cashierName}}</strong></div>
        <div class="meta-row">Customer Name: <strong>{{customerName}}</strong></div>
        {{#if customerPhone}}
        <div class="meta-row">Customer Phone: <strong class="font-mono">{{customerPhone}}</strong></div>
        {{/if}}
      </div>
    </div>

    <!-- Itemized Table -->
    <table class="items-table">
      <thead>
        <tr>
          <th style="width: 30px;">#</th>
          <th style="text-align: left;">Item Description</th>
          <th class="text-center" style="width: 60px;">Qty</th>
          <th class="text-right" style="width: 80px;">Rate (₹)</th>
          <th class="text-right" style="width: 60px;">GST %</th>
          <th class="text-right" style="width: 90px;">Total (₹)</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td class="text-center" style="color: #94a3b8;">{{increment @index}}</td>
          <td>
            <div class="font-bold" style="color: #0f172a;">{{this.name}}</div>
            {{#if this.sku}}
            <div style="font-size: 9px; color: #94a3b8;" class="font-mono">SKU: {{this.sku}}</div>
            {{/if}}
          </td>
          <td class="text-center font-bold">{{this.qty}} {{this.unit}}</td>
          <td class="text-right font-mono">₹{{toFixed this.priceAtOrder 2}}</td>
          <td class="text-right font-mono" style="color: #d97706;">{{this.taxRate}}%</td>
          <td class="text-right font-mono font-bold">₹{{toFixed this.lineTotal 2}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Summary Box -->
    <div class="summary-section">
      <div class="terms-box">
        <div class="font-bold" style="color: #334155; margin-bottom: 4px;">Terms & Conditions:</div>
        <div>1. Goods once sold can be returned within 7 days with valid invoice.</div>
        <div>2. All disputes subject to local jurisdiction.</div>
        <div>3. Computer generated invoice requires no physical signature.</div>
      </div>

      <div class="totals-box">
        <div class="total-row">
          <span>Subtotal (Taxable):</span>
          <span class="font-mono font-bold">₹{{toFixed subtotal 2}}</span>
        </div>
        <div class="total-row">
          <span>CGST (Central Tax):</span>
          <span class="font-mono">₹{{toFixed cgst 2}}</span>
        </div>
        <div class="total-row">
          <span>SGST (State Tax):</span>
          <span class="font-mono">₹{{toFixed sgst 2}}</span>
        </div>
        {{#if discount}}
        <div class="total-row" style="color: #16a34a; font-weight: 700;">
          <span>Discount Applied:</span>
          <span class="font-mono">-₹{{toFixed discount 2}}</span>
        </div>
        {{/if}}
        <div class="total-row total-grand">
          <span>GRAND TOTAL:</span>
          <span class="font-mono">₹{{toFixed totalAmount 2}}</span>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      Thank You For Shopping At <strong>{{storeName}}</strong>! Please Visit Again.
    </div>
  </div>
</body>

</html>